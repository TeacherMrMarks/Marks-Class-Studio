import {getStore} from '@netlify/blobs';
import {authorize} from '../shared/auth.mjs';
export default async(req:Request)=>{const denied=await authorize(req);if(denied)return denied;const store=getStore({name:'marks-class-curriculum-v16',consistency:'strong'});try{if(req.method==='GET'){const {blobs}=await store.list();const data=await Promise.all(blobs.map(async b=>({kind:b.key.split('/')[0],item:await store.get(b.key,{type:'json'})})));return Response.json({ok:true,skills:data.filter(x=>x.kind==='skills'&&x.item).map(x=>x.item),plans:data.filter(x=>x.kind==='plans'&&x.item).map(x=>x.item)},{headers:{'Cache-Control':'private, no-store'}});}if(req.method!=='POST')return Response.json({ok:false},{status:405});const {kind,item}=await req.json();if(!['skills','plans'].includes(kind)||!item||typeof item.id!=='string'||!/^[-\w]{1,100}$/.test(item.id)||typeof item.updatedAt!=='string'||JSON.stringify(item).length>500000)return Response.json({ok:false,error:'Registro inválido.'},{status:400});const key=kind+'/'+item.id;const old=await store.get(key,{type:'json'});if(old&&(old.deleted||!item.deleted&&old.updatedAt>item.updatedAt))return Response.json({ok:true,item:old});await store.setJSON(key,item);return Response.json({ok:true,item});}catch{return Response.json({ok:false,error:'Falha na sincronização curricular.'},{status:500})}};
