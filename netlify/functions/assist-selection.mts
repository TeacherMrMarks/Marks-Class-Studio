const extractText=(json:any)=>{if(typeof json?.output_text==='string')return json.output_text;const out:string[]=[];for(const item of json?.output||[])for(const c of item?.content||[])if(typeof c?.text==='string')out.push(c.text);return out.join('\n');};
export default async(req:Request)=>{
  if(req.method!=='POST')return new Response('Method not allowed',{status:405});const apiKey=process.env.OPENAI_API_KEY;if(!apiKey)return Response.json({ok:false,error:'IA não configurada.'},{status:503});
  try{const body=await req.json() as {component?:string;grade?:string;mode?:string;text?:string};const mode=body.mode==='similar'?'Crie uma nova questão ou bloco semelhante, mantendo habilidade e dificuldade, mas sem copiar':'Melhore clareza, correção, adequação pedagógica e formatação do trecho, preservando sua intenção';const instructions=`Você é um assistente de edição pedagógica. ${mode}. O componente é ${body.component==='life-project'?'Projeto de Vida':'Língua Inglesa'} e a turma é ${String(body.grade||'')}. Responda SOMENTE com HTML simples do trecho final, sem markdown, cabeçalho ou explicações. Use p,strong,em,u,ol,ul,li,br,table,tbody,tr,td,th.`;const input=String(body.text||'').slice(0,7000);const model=process.env.OPENAI_MODEL||'gpt-6-luna';const r=await fetch('https://api.openai.com/v1/responses',{method:'POST',headers:{Authorization:`Bearer ${apiKey}`,'Content-Type':'application/json'},body:JSON.stringify({model,instructions,input})});const json=await r.json();if(!r.ok)return Response.json({ok:false,error:json?.error?.message||'Falha na API.'},{status:r.status});let html=extractText(json).trim().replace(/^```(?:html)?\s*/i,'').replace(/\s*```$/,'');return Response.json({ok:true,html});}catch(error){return Response.json({ok:false,error:error instanceof Error?error.message:String(error)},{status:500});}
};
