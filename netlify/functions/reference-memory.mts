import { authorize } from '../shared/auth.mjs';
import { refStore, allReferences, metaKey, partKey, validRef, CHUNK, MAX_BYTES, type RefMeta } from '../shared/reference-memory.mjs';
const json=(data:unknown,status=200)=>Response.json(data,{status,headers:{'Cache-Control':'private, no-store'}});
const fail=(error:string,status=400)=>json({ok:false,error},status);
const clean=(v:unknown,max:number)=>typeof v==='string'?v.slice(0,max):'';
const summary=({text,...r}:RefMeta)=>({...r,characters:text.length});
function classify(b:any){return {component:['english','life-project','general'].includes(b.component)?b.component:'general',grade:clean(b.grade,100),kind:clean(b.kind,100)};}
export default async(req:Request)=>{const denied=await authorize(req);if(denied)return denied;try{const store=refStore();const url=new URL(req.url);if(req.method==='GET'){const action=url.searchParams.get('action')||'list';if(action==='list')return json({ok:true,data:(await allReferences()).map(summary)});const id=url.searchParams.get('id');if(!validRef(id))return fail('Identificação inválida.');const m=await store.get(metaKey(id),{type:'json'}) as RefMeta|null;if(!m)return fail('Referência não encontrada.',404);if(action==='meta')return json({ok:true,data:m});if(action==='part'){const i=Number(url.searchParams.get('index'));if(!Number.isInteger(i)||i<0||i>=m.parts)return fail('Parte inválida.');const data=await store.get(partKey(id,i),{type:'json'});return data?json({ok:true,data:data.base64}):fail('Parte original não encontrada.',404);}return fail('Ação inválida.');}if(req.method!=='POST')return fail('Método inválido.',405);const b=await req.json();const id=b.id;if(!validRef(id))return fail('Identificação inválida.');const existing=await store.get(metaKey(id),{type:'json'}) as RefMeta|null;
if(b.action==='part'){if(existing)return json({ok:true,duplicate:true});const index=Number(b.index);const base64=b.base64;if(!Number.isInteger(index)||index<0||index>=Math.ceil(MAX_BYTES/CHUNK)||typeof base64!=='string'||!base64.length||base64.length>Math.ceil(CHUNK/3)*4||!/^[A-Za-z0-9+/]+={0,2}$/.test(base64)||base64.length%4!==0)return fail('Parte inválida.');await store.setJSON(partKey(id,index),{base64});return json({ok:true});}
if(b.action==='commit'){if(existing)return json({ok:true,data:existing,duplicate:true});const size=Number(b.size),parts=Number(b.parts);if(!Number.isInteger(size)||size<1||size>MAX_BYTES||parts!==Math.ceil(size/CHUNK)||! /\.(pdf|docx)$/i.test(String(b.name)))return fail('Arquivo inválido.');const full=new Uint8Array(size);for(let start=0;start<parts;start+=8){const block=await Promise.all(Array.from({length:Math.min(8,parts-start)},(_,i)=>store.get(partKey(id,start+i),{type:'json'})));for(const [offset,part] of block.entries()){const i=start+offset;if(!part||typeof part.base64!=='string')return fail('Envio incompleto: tente novamente.');const bytes=Uint8Array.from(atob(part.base64),c=>c.charCodeAt(0));if(bytes.length!==Math.min(CHUNK,size-i*CHUNK))return fail('Tamanho incorreto do original.');full.set(bytes,i*CHUNK);}}const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',full)),n=>n.toString(16).padStart(2,'0')).join('');if(digest!==id)return fail('Original não passou na verificação de integridade.');const now=new Date().toISOString();const m:RefMeta={id,name:clean(b.name,250),...classify(b),sourceUrl:/^https?:\/\//i.test(String(b.sourceUrl))?clean(b.sourceUrl,2000):'',size,parts,createdAt:now,updatedAt:now,status:'stored',note:'Original armazenado; aguardando leitura.',text:'',pages:0};await store.setJSON(metaKey(id),m);return json({ok:true,data:m});}
if(!existing)return fail('Referência não encontrada.',404);
if(b.action==='update'){const text=clean(b.text,1500000);const status=b.status==='processed'&&text.trim()?'processed':b.status==='partial'||text.trim()?'partial':'stored';const m:RefMeta={...existing,...classify({...existing,...b}),text,status,note:clean(b.note,1000),pages:Math.max(0,Math.min(10000,Number(b.pages)||0)),updatedAt:new Date().toISOString()};await store.setJSON(metaKey(id),m);return json({ok:true,data:m});}
if(b.action==='delete'){await store.delete(metaKey(id));for(let i=0;i<existing.parts;i++)await store.delete(partKey(id,i));return json({ok:true});}return fail('Ação inválida.');}catch(e){return fail(e instanceof Error?e.message:'Falha na memória pedagógica.',500);}};
