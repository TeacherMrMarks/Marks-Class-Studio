import {authorize} from '../shared/auth.mjs';
import {allQuestions,indexQuestions,questionStore,type Question} from '../shared/question-bank.mjs';
import {refStore,metaKey,validRef,type RefMeta} from '../shared/reference-memory.mjs';
const json=(x:unknown,status=200)=>Response.json(x,{status,headers:{'Cache-Control':'private, no-store'}});
const fail=(error:string,status=400)=>json({ok:false,error},status);
const s=(v:unknown,n:number)=>typeof v==='string'?v.slice(0,n):'';
export default async(req:Request)=>{const denied=await authorize(req);if(denied)return denied;try{const store=questionStore();if(req.method==='GET')return json({ok:true,data:await allQuestions()});if(req.method!=='POST')return fail('Método inválido',405);const b=await req.json();if(b.action==='extract'){if(!validRef(b.id))return fail('Referência inválida');const m=await refStore().get(metaKey(b.id),{type:'json'}) as RefMeta|null;if(!m)return fail('Referência não encontrada',404);return json({ok:true,added:await indexQuestions(m)});}if(typeof b.id!=='string'||!/^[\w-]{1,100}$/.test(b.id))return fail('ID inválido');if(b.action==='delete'){await store.setJSON('deleted/'+b.id,{deleted:true});await store.delete('q/'+b.id);return json({ok:true});}if(b.action!=='save')return fail('Ação inválida');if(await store.get('deleted/'+b.id,{type:'json'}))return json({ok:true,deleted:true});if(typeof b.html!=='string'||!b.html.trim()||b.html.length>1800000)return fail('Questão vazia ou muito grande (limite de 1,8 milhão de caracteres).');const old=await store.get('q/'+b.id,{type:'json'}) as Question|null;if(b.restore&&old&&old.updatedAt>=s(b.updatedAt,50))return json({ok:true,data:old});const q:Question={id:b.id,editorType:['image','text','wordsearch','matching','gaps','truefalse','ordering','correction','translation','writing','free'].includes(b.editorType)?b.editorType:undefined,series:Array.isArray(b.series)?[...new Set<string>(b.series.filter((x:unknown)=>['1','2','3'].includes(String(x))).map(String))]:undefined,schoolMode:['Regular','EMTI','Ambas'].includes(b.schoolMode)?b.schoolMode:'',generatorData:s(b.generatorData,60000),responseLines:Math.max(0,Math.min(30,Math.trunc(Number(b.responseLines)||0))),curriculumIds:Array.isArray(b.curriculumIds)?b.curriculumIds.filter((x:unknown)=>typeof x==='string').slice(0,50):[],curriculumObjects:Array.isArray(b.curriculumObjects)?b.curriculumObjects.filter((x:unknown)=>typeof x==='string').slice(0,100).map((x:string)=>s(x,2000)):[],name:s(b.name,250),skill:s(b.skill,3000),filters:Array.isArray(b.filters)?b.filters.filter((x:unknown)=>typeof x==='string').slice(0,100).map((x:string)=>s(x,100)):[],correct:/^[A-J]$/.test(b.correct||'')?b.correct:'',justification:s(b.justification,10000),columns:[1,2,3].includes(b.columns)?b.columns:1,gap:Math.max(2,Math.min(20,Number(b.gap)||8)),divider:!!b.divider,columnWidth:Math.max(25,Math.min(75,Number(b.columnWidth)||50)),structured:!!b.structured,sourceId:s(b.sourceId,100),sourceName:s(b.sourceName,250),number:s(b.number,20),component:['english','life-project','general'].includes(b.component)?b.component:'general',grade:s(b.grade,100),topic:s(b.topic,200),kind:s(b.kind,100),html:b.html,context:s(b.context,10000),answer:s(b.answer,10000),reviewed:!!b.reviewed,updatedAt:b.restore?s(b.updatedAt,50)||new Date().toISOString():new Date().toISOString()};await store.setJSON('q/'+q.id,q);return json({ok:true,data:q});}catch(e){return fail(e instanceof Error?e.message:'Falha no banco de questões',500);}};
